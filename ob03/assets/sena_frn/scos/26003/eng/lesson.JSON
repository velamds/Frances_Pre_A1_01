type": "RSLT", "template_override": 1}, {"id": 11, "stimuli_ids": [], "questions": [{"_data": [{"type": "question", "contents": [{"content": "frn1le01ob03re7pdf01.pdf", "type": "pdf"}]}], "responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 1}], "id": 0}], "_data": [{"type": "instructions", "contents": [{"content": " Imaginez que vous \u00eates un nouvel \u00e9tudiant/une nouvelle \u00e9tudiante. Vous avez besoin d'une carte d'\u00e9tudiant. Quelle information personnelle donnez-vous pour l'obtenir ?", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "allowed_attempts": 2, "attempt_feedback": [{"content": "You have 2 tries.", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Try again.", "type": "text"}, {"content": "Maybe next time\u2026", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"value": "{\"type\": \"skill\", \"content\": \"Reading\"}", "content": "Reading", "type": "skill", "valid": 1}, {"value": "{\"type\": \"skill\", \"content\": \"Writing\"}", "content": "Writing", "type": "skill", "valid": 1}, {"value": "{\"type\": \"skill\", \"content\": \"Speaking\"}", "content": "Speaking", "type": "skill", "valid": 1}]}, {"type": "post_instructions", "contents": [{"content": "Consignes : Compl\u00e9tez les \u00e9tapes suivantes. Remplissez la grille d'auto-\u00e9valuation.", "type": "text"}]}], "type": "DWS", "template_override": 1}], "stimuli": [{"_data": [], "type": "welcome", "contents": [{}], "template_override": 1, "id": 0}, {"id": 1, "title": "", "contents": [{"value": {"images": [{"text": "", "id": 0, "time": "0", "image": "frn1le01ob03re2img01.jpg"}, {"text": "<span class=\"strong\">Coraline</span> : Bonjour, monsieur. Comment allez-vous ? Je suis une nouvelle \u00e9tudiante. <br/>\n<span class=\"strong\">M. Leclerc</span> : Bonjour, mademoiselle. Je m'appelle Christophe Leclerc. Je suis le chef du bureau des inscriptions. Voici un formulaire que vous devez remplir. <br/>\n<span class=\"strong\">Coraline</span> : Merci, Monsieur Leclerc. Pouvez-vous m'aider s'il vous pla\u00eet ? Je ne suis pas d'ici.<br/>\n<span class=\"strong\"> M. Leclerc </span> : Bien s\u00fbr. Quel est votre pr\u00e9nom ? <br/>\n<span class=\"strong\">Coraline</span> : Coraline. <br/>", "id": 1, "time": "20", "image": "frn1le01ob03re2img01.jpg"}, {"text": "<span class=\"strong\">M. Leclerc</span> : Tr\u00e8s bien. Et votre nom de famille ?<br/>\n<span class=\"strong\">Coraline</span> : Lafarge. <br/>\n<span class=\"strong\">M. Leclerc</span> : Parfait. Coraline Lafarge. Quelle est votre adresse, Mademoiselle Lafarge ? <br/>\n<span class=\"strong\">Coraline</span> : Mon adresse est 123, rue Laval. <br/>\n<span class=\"strong\">M. Leclerc</span> : 124, rue Lavall\u00e9e ? <br/>", "id": 2, "time": "22000", "image": "frn1le01ob03re2img01.jpg"}, {"text": "<span class=\"strong\">Coraline</span> : Non, monsieur. Mon adresse n'est pas 124, rue Lavall\u00e9e, mais 123, rue Laval. Mon m\u00e9l est CLafarge@intel.fr.<br/>\n<span class=\"strong\">M. Leclerc</span> : D'accord, c'est bien not\u00e9. Merci. Votre carte d'\u00e9tudiant est pr\u00eate. La voici ! <br/>\n<span class=\"strong\">Coraline</span> : Merci beaucoup, Monsieur Leclerc. Au revoir. <br/>\n<span class=\"strong\">M. Leclerc</span> : Je vous en prie, Mademoiselle Lafarge. \u00c0 la prochaine.", "id": 3, "time": "36000", "image": "frn1le01ob03re2img01.jpg"}], "audiosrc": "frn1le01ob03re2aud01", "coverimg": "frn1le01ob03re2img01.jpg"}, "type": "slideshow"}], "_data": [{"content": [], "type": "tips"}], "type": "audio", "template_override": 1}]}]}